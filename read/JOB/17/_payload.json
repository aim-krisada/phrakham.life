[{"data":1,"prerenderedAt":572},["ShallowReactive",2],{"บท:JOB\u002F17":3,"บัญชีเล่ม":131},{"เล่ม":4,"บท":19,"ชั้น":52,"ลำดับชั้น":121,"แหล่งของชั้น":126},{"ข้อสุดท้าย":5,"ชื่อไทย":29,"บท":30,"บทที่มี":31,"พันธสัญญา":50,"รหัส":51},[6,7,8,9,10,11,9,6,12,6,13,14,15,6,12,6,16,9,17,17,18,11,19,14,20,21,22,15,14,23,24,6,25,26,16,25,27,28,11,27,18,19],22,13,26,21,27,30,35,20,25,28,16,29,34,17,6,14,23,31,40,33,37,24,41,"โยบ",42,[32,33,34,35,36,20,37,38,39,40,41,42,7,21,43,16,19,44,45,13,9,6,22,27,14,8,10,15,17,11,23,46,25,18,12,47,26,48,49,24,28,30],1,2,3,4,5,7,8,9,10,11,12,15,18,19,32,36,38,39,"เดิม","JOB",{"LSV":53,"TCV":70,"THKJV":87,"WEB":104},{"1":54,"2":55,"3":56,"4":57,"5":58,"6":59,"7":60,"8":61,"9":62,"10":63,"11":64,"12":65,"13":66,"14":67,"15":68,"16":69},"“My spirit has been destroyed, || My days extinguished—graves [are] for me.","If not—mockeries [are] with me. And my eye lodges in their provocations.","Now place my pledge with You; Who is he that strikes hand with me?","For You have hidden their heart from understanding, || Therefore You do not exalt them.","For a portion he shows friendship, || And the eyes of his sons are consumed.","And He set me up for a proverb of the peoples, || And I am a wonder before them.","And my eye is dim from sorrow, || And my members—all of them—as a shadow.","The upright are astonished at this, and the innocent stirs himself up against the profane.","And the righteous lays hold [on] his way, || And the clean of hands adds strength.","But please return and come in, all of you, || And I do not find a wise man among you.","My days have passed by, || My plans have been broken off, || The possessions of my heart!","They appoint night for day, || Light [is] near because of darkness.","If I wait—Sheol [is] my house, || In darkness I have spread out my bed.","To corruption I have called: You [are] my father. To the worm: My mother and my sister.","And where [is] my hope now? Indeed, my hope, who beholds it?","You go down [to] the parts of Sheol, || If we may rest together on the dust.”",{"1":71,"2":72,"3":73,"4":74,"5":75,"6":76,"7":77,"8":78,"9":79,"10":80,"11":81,"12":82,"13":83,"14":84,"15":85,"16":86},"จิต​วิญญาณ​ของ​ข้า​แหลก​สลาย\n  วัน​คืน​ของ​ข้า​หด​สั้น​ลง\n  หลุม​ฝัง​ศพ​รอ​ข้า​อยู่","แน่นอน​คน​เยาะเย้ย​อยู่​รอบ​ตัว​ข้า\n  ตา​ข้า​ต้อง​มอง​ดู​ความ​เกลียด​ชัง​ของ​เขา","“ข้าแต่​พระเจ้า ขอให้​ข้า​มี​สิ่ง​ค้ำ​ประกัน​ที่​พระองค์​เรียกร้อง\n  ใคร​เล่า​จะ​ค้ำประกัน​ให้​ข้า","พระองค์​ปิด​ความ​คิด​ของ​พวก​เขา​จาก​ความ​เข้าใจ\n  ฉะนั้น​พระองค์​จะ​ไม่​ปล่อย​ให้​เขา​มี​ชัยชนะ","ถ้า​ใคร​ปรักปรำ​เพื่อน​เพราะ​เห็น​แก่​สินบน\n  ลูกหลาน​ของ​เขา​จะ​ตา​มืดมัว","พระเจ้า​ทำ​ให้​ข้า​ตก​เป็น​ขี้ปาก​ของ​ทุก​คน\n  พวก​เขา​ถ่ม​น้ำลาย​ใส่​หน้า​ข้า","ตา​ของ​ข้า​มืดมัว​เพราะ​ความ​ทุกข์​โศก\n  และ​ร่างกาย​ของ​ข้า​เป็น​เพียง​เงา","คน​ชอบธรรม​ใจ​หาย​เมื่อ​เห็น​ข้า\n  คน​ไร้​ความ​ผิด​ถูก​ปลุก​ขึ้น​ให้​ต่อต้าน​คน​อธรรม","แต่​คน​ชอบธรรม​จะ​ยึดมั่น​ใน​วิถี​ของ​ตน\n  คน​มือ​สะอาด​จะ​แข็งแกร่ง​ขึ้น","ส่วน​พวก​เจ้า​ทุก​คน มา​สิ ลอง​ดู​อีก!\n  ข้า​จะ​ไม่​พบ​สัก​คน​ที่​มี​ปัญญา​ใน​พวก​เจ้า​เลย","วัน​คืน​ผ่านพ้น​ไป แผนการ​ของ​ข้า​พัง​ทลาย\n  กระนั้น​ความ​ปรารถนา​ใน​ใจ​ข้า","ก็​เปลี่ยน​กลางคืน​เป็น​กลางวัน\n  ใน​ความ​มืด​นั้น ความ​สว่าง​ก็​มา​ใกล้​แล้ว","หาก​บ้าน​เดียว​ที่​ข้า​หวัง​คือ​หลุม​ฝัง​ศพ\n  หาก​ข้า​กาง​ที่​นอน​ใน​แดน​แห่ง​ความ​มืด​มิด","หาก​ข้า​เรียก​ความ​เสื่อม​ทราม​ว่า ‘พ่อ’\n  และ​เรียก​หนอน​ว่า ‘แม่’ หรือ ‘พี่​สาว’","แล้ว​อย่าง​นั้น​ความ​หวัง​ของ​ข้า​อยู่​ที่​ไหน\n  ใคร​บ้าง​จะ​เห็น​ความ​หวัง​ใน​ตัว​ข้า","หรือ​ความ​หวัง​ของ​ข้า จะ​ลง​ไป​สู่​ประตู​แห่ง​ความ​ตาย\n  เรา​จะ​ลง​ไป​ใน​ธุลี​ดิน​ด้วย​กัน​หรือ”",{"1":88,"2":89,"3":90,"4":91,"5":92,"6":93,"7":94,"8":95,"9":96,"10":97,"11":98,"12":99,"13":100,"14":101,"15":102,"16":103},"“ลมหายใจของข้าได้​แตกดับ​ วันเวลาของข้าก็จบลง หลุมฝังศพพร้อมสำหรับข้าแล้ว","​แน่​​ละ​ คนมักเยาะเย้​ยก​็​อยู่​รอบข้านี่​เอง​ และตาของข้าก็จ้องอยู่​ที่​การยั่วเย้าของเขา","‘โปรดทรงวางประกันไว้สำหรับข้าพระองค์กับพระองค์ ใครอยู่​ที่​นั่​นที​่จะให้ประกันสำหรับข้าพระองค์​ได้​","เพราะพระองค์ทรงปิดใจของเขาทั้งหลายไว้จากความเข้าใจ ฉะนั้นพระองค์จะไม่ทรงยกย่องเขา’","​ผู้​​ที่​​กล​่าวคำประจบประแจงแก่เพื่อนของเขา ​นัยน์​ตาของลูกหลานของเขาจะมัวมืดไป","​พระองค์​ทรงกระทำให้ข้าเป็นคำครหาของชนชาติ​ทั้งหลาย​ ​แต่​ก่อนนั้นข้าเป็นเหมือนรำมะนา","​นัยน์​ตาของข้าได้มื​ดม​ัวไปด้วยความโศกสลด และอวัยวะทั้งสิ้นของข้าก็เหมือนกับเงา","คนเที่ยงธรรมก็จะตกตะลึ​งด​้วยเรื่องนี้ และคนไร้ผิ​ดก​็จะเร้าตัวขึ้นปรักปรำคนหน้าซื่อใจคด","คนชอบธรรมยังจะยึ​ดม​ั่นอยู่กับทางของเขา และผู้​ที่​​มี​มือสะอาดก็จะแข็งแรงยิ่งขึ้นๆ","​แต่​พวกท่าน ท่านทุกคนมาอีกซี ข้าจะไม่พบคนที่​มี​ปัญญาสักคนในพวกท่าน","วันของข้าก็ผ่านพ้นไป แผนงานของข้าก็​แตกหัก​ คือความคิดในใจของข้านั้น","เขาเหล่านั้นทำกลางคืนให้เป็นกลางวัน ความสว่างนั้​นก​็สั้นเพราะเหตุ​ความมืด​","ถ้าข้ารอคอย แดนคนตายจะเป็นบ้านของข้า ข้าได้กางที่นอนออกในความมืด","ข้าได้​พู​​ดก​ับความเปื่อยเน่าว่า ‘​เจ้​าเป็นพ่อของข้า’ และพู​ดก​ับหนอนว่า\n‘​เจ้​าเป็นแม่ของข้าและเป็นพี่สาวของข้า’","​แล​้วบัดนี้ความหวังของข้าอยู่​ที่​ไหนเล่า ส่วนความหวังของข้านั้นใครจะเห็นได้","ความหวังนั้นจะลงไปที่ดาลประตูแดนคนตาย เราจะลงไปด้วยกันในผงคลี​ดิน​”",{"1":105,"2":106,"3":107,"4":108,"5":109,"6":110,"7":111,"8":112,"9":113,"10":114,"11":115,"12":116,"13":117,"14":118,"15":119,"16":120},"“My spirit is consumed.\n\nMy days are extinct\n\nand the grave is ready for me.","Surely there are mockers with me.\n\nMy eye dwells on their provocation.","“Now give a pledge. Be collateral for me with yourself.\n\nWho is there who will strike hands with me?","For you have hidden their heart from understanding,\n\ntherefore you will not exalt them.","He who denounces his friends for plunder,\n\neven the eyes of his children will fail.","“But he has made me a byword of the people.\n\nThey spit in my face.","My eye also is dim by reason of sorrow.\n\nAll my members are as a shadow.","Upright men will be astonished at this.\n\nThe innocent will stir himself up against the godless.","Yet the righteous will hold to his way.\n\nHe who has clean hands will grow stronger and stronger.","But as for you all, come back.\n\nI will not find a wise man among you.","My days are past.\n\nMy plans are broken off,\n\nas are the thoughts of my heart.","They change the night into day,\n\nsaying ‘The light is near’ in the presence of darkness.","If I look for Sheol as my house,\n\nif I have spread my couch in the darkness,","if I have said to corruption, ‘You are my father,’\n\nand to the worm, ‘My mother,’ and ‘My sister,’","where then is my hope?\n\nAs for my hope, who will see it?","Shall it go down with me to the gates of Sheol,\n\nor descend together into the dust?”",[122,123,124,125],"TCV","THKJV","WEB","LSV",{"LSV":127,"TCV":128,"THKJV":129,"WEB":130},"Literal Standard Version","Thai Common Version 2025","Thai KJV 2003","World English Bible",{"จำนวนบท":132,"จำนวนเล่ม":133,"เล่ม":134},1190,66,[135,151,157,163,172,179,185,190,195,201,206,212,217,223,228,234,240,245,248,336,341,346,351,356,361,366,371,376,381,386,391,396,401,406,411,416,421,426,431,436,442,447,452,457,462,467,472,477,482,487,492,497,502,507,512,517,522,527,532,537,542,547,552,557,562,567],{"ข้อสุดท้าย":136,"ชื่อไทย":142,"บท":143,"บทที่มี":144,"พันธสัญญา":50,"รหัส":150},[23,14,27,8,46,6,27,6,17,46,46,13,44,27,9,16,10,25,48,44,18,27,13,137,18,12,138,6,12,139,140,46,13,23,17,139,47,11,22,22,141,48,18,18,15,18,23,6,25,8],67,46,43,55,57,"ปฐมกาล",50,[32,33,34,35,36,20,37,38,39,40,41,42,7,21,43,16,19,44,45,13,9,6,22,27,14,8,10,15,17,11,23,46,25,18,12,47,26,48,49,24,28,30,139,145,146,138,147,148,149,143],44,45,47,48,49,"GEN",{"ข้อสุดท้าย":152,"ชื่อไทย":154,"บท":24,"บทที่มี":155,"พันธสัญญา":50,"รหัส":156},[6,14,6,23,22,11,14,46,12,17,40,153,6,23,10,47,16,10,14,8,47,23,25,44,24,26,9,139,138,48,44,12,22,12,12,48,17,23,139,48],51,"อพยพ",[32,33,34,35,36,20,37,38,39,40,41,42,7,21,43,16,19,44,45,13,9,6,22,27,14,8,10,15,17,11,23,46,25,18,12,47,26,48,49,24],"EXO",{"ข้อสุดท้าย":158,"ชื่อไทย":160,"บท":10,"บทที่มี":161,"พันธสัญญา":50,"รหัส":162},[19,16,19,12,45,11,48,47,27,13,147,38,159,141,25,18,16,11,26,10,27,25,145,22,140,138