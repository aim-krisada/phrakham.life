[{"data":1,"prerenderedAt":532},["ShallowReactive",2],{"บท:JOB\u002F25":3,"บัญชีเล่ม":91},{"เล่ม":4,"บท":14,"ชั้น":52,"ลำดับชั้น":81,"แหล่งของชั้น":86},{"ข้อสุดท้าย":5,"ชื่อไทย":29,"บท":30,"บทที่มี":31,"พันธสัญญา":50,"รหัส":51},[6,7,8,9,10,11,9,6,12,6,13,14,15,6,12,6,16,9,17,17,18,11,19,14,20,21,22,15,14,23,24,6,25,26,16,25,27,28,11,27,18,19],22,13,26,21,27,30,35,20,25,28,16,29,34,17,6,14,23,31,40,33,37,24,41,"โยบ",42,[32,33,34,35,36,20,37,38,39,40,41,42,7,21,43,16,19,44,45,13,9,6,22,27,14,8,10,15,17,11,23,46,25,18,12,47,26,48,49,24,28,30],1,2,3,4,5,7,8,9,10,11,12,15,18,19,32,36,38,39,"เดิม","JOB",{"LSV":53,"TCV":60,"THKJV":67,"WEB":74},{"1":54,"2":55,"3":56,"4":57,"5":58,"6":59},"And Bildad the Shuhite answers and says:","“The rule and fear [are] with Him, || Making peace in His high places.","Is there [any] number to His troops? And on whom does His light not arise?","And what? Is man righteous with God? And what? Is he pure—born of a woman?","Behold—to the moon, and it does not shine, || And stars have not been pure in His eyes.","How much less man—a grub, || And the son of man—a worm!”",{"1":61,"2":62,"3":63,"4":64,"5":65,"6":66},"แล้ว​บิลดัด​ชาว​ชูอาห์​โต้ตอบ​ว่า","“อำนาจ​ครอบครอง​และ​ความ​น่า​เกรงขาม​เป็น​ของ​พระเจ้า\n  พระองค์​ตั้ง​ความ​เป็น​ระเบียบ​ใน​สวรรค์​เบื้อง​สูง","กองทัพ​ของ​พระองค์​นั้น​นับ​ได้​หรือ\n  ใคร​เล่า​ที่​แสง​สว่าง​ของ​พระองค์​ส่อง​ไม่​ถึง","มนุษย์​จะ​ชอบธรรม​ต่อหน้า​พระเจ้า​ได้​อย่างไร\n  คน​ที่​เกิด​จาก​ผู้หญิง​จะ​บริสุทธิ์​ได้​อย่างไร","ถ้า​แม้​แสง​จันทร์​ยัง​ไม่​กระจ่าง\n  และ​ดวง​ดาว​ยัง​ไม่​บริสุทธิ์​ใน​สายตา​ของ​พระองค์​เลย","แล้ว​จะ​เหลือ​อะไร​กับ​มนุษย์ ซึ่ง​เป็น​เพียง​ตัว​ดักแด้\n  มนุษย์​ซึ่ง​เป็น​แค่​ตัว​หนอน!”",{"1":68,"2":69,"3":70,"4":71,"5":72,"6":73},"​แล​้วบิ​ลด​ัดคนชูอาห์ตอบว่า","“พระเจ้าทรงอำนาจในการครอบครองและทรงให้ยำเกรงพระองค์ ทรงกระทำสันติภาพในสวรรค์เบื้องสูงของพระองค์","กองทัพของพระองค์​มี​จำนวนหรือ ความสว่างของพระองค์​มิได้​ส่องมาเหนือผู้ใดบ้าง","​แล​้วมนุษย์จะชอบธรรมต่อพระพักตร์พระเจ้าได้​อย่างไร​ ​คนที​่​เก​ิดจากผู้หญิงจะสะอาดได้​อย่างไร​","​ดู​​เถิด​ ​ถึงแม้​​ดวงจันทร์​​ก็​​ไม่มี​ความสุกใส และดวงดาวก็​ไม่​​บริสุทธิ์​ในสายพระเนตรของพระองค์","​มนุษย์​จะยิ่งสะอาดน้อยกว่านั้นเท่าใด ​ผู้​เป็นเพียงตัวดักแด้ และบุตรของมนุษย์​เล่า​\n​ผู้​เป็นเพียงตัวหนอน”",{"1":75,"2":76,"3":77,"4":78,"5":79,"6":80},"Then Bildad the Shuhite answered,","“Dominion and fear are with him.\n\nHe makes peace in his high places.","Can his armies be counted?\n\nOn whom does his light not arise?","How then can man be just with God?\n\nOr how can he who is born of a woman be clean?","Behold, even the moon has no brightness,\n\nand the stars are not pure in his sight;","How much less man, who is a worm,\n\nand the son of man, who is a worm!”",[82,83,84,85],"TCV","THKJV","WEB","LSV",{"LSV":87,"TCV":88,"THKJV":89,"WEB":90},"Literal Standard Version","Thai Common Version 2025","Thai KJV 2003","World English Bible",{"จำนวนบท":92,"จำนวนเล่ม":93,"เล่ม":94},1190,66,[95,111,117,123,132,139,145,150,155,161,166,172,177,183,188,194,200,205,208,296,301,306,311,316,321,326,331,336,341,346,351,356,361,366,371,376,381,386,391,396,402,407,412,417,422,427,432,437,442,447,452,457,462,467,472,477,482,487,492,497,502,507,512,517,522,527],{"ข้อสุดท้าย":96,"ชื่อไทย":102,"บท":103,"บทที่มี":104,"พันธสัญญา":50,"รหัส":110},[23,14,27,8,46,6,27,6,17,46,46,13,44,27,9,16,10,25,48,44,18,27,13,97,18,12,98,6,12,99,100,46,13,23,17,99,47,11,22,22,101,48,18,18,15,18,23,6,25,8],67,46,43,55,57,"ปฐมกาล",50,[32,33,34,35,36,20,37,38,39,40,41,42,7,21,43,16,19,44,45,13,9,6,22,27,14,8,10,15,17,11,23,46,25,18,12,47,26,48,49,24,28,30,99,105,106,98,107,108,109,103],44,45,47,48,49,"GEN",{"ข้อสุดท้าย":112,"ชื่อไทย":114,"บท":24,"บทที่มี":115,"พันธสัญญา":50,"รหัส":116},[6,14,6,23,22,11,14,46,12,17,40,113,6,23,10,47,16,10,14,8,47,23,25,44,24,26,9,99,98,48,44,12,22,12,12,48,17,23,99,48],51,"อพยพ",[32,33,34,35,36,20,37,38,39,40,41,42,7,21,43,16,19,44,45,13,9,6,22,27,14,8,10,15,17,11,23,46,25,18,12,47,26,48,49,24],"EXO",{"ข้อสุดท้าย":118,"ชื่อไทย":120,"บท":10,"บ