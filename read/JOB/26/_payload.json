[{"data":1,"prerenderedAt":564},["ShallowReactive",2],{"บท:JOB\u002F26":3,"บัญชีเล่ม":123},{"เล่ม":4,"บท":8,"ชั้น":52,"ลำดับชั้น":113,"แหล่งของชั้น":118},{"ข้อสุดท้าย":5,"ชื่อไทย":29,"บท":30,"บทที่มี":31,"พันธสัญญา":50,"รหัส":51},[6,7,8,9,10,11,9,6,12,6,13,14,15,6,12,6,16,9,17,17,18,11,19,14,20,21,22,15,14,23,24,6,25,26,16,25,27,28,11,27,18,19],22,13,26,21,27,30,35,20,25,28,16,29,34,17,6,14,23,31,40,33,37,24,41,"โยบ",42,[32,33,34,35,36,20,37,38,39,40,41,42,7,21,43,16,19,44,45,13,9,6,22,27,14,8,10,15,17,11,23,46,25,18,12,47,26,48,49,24,28,30],1,2,3,4,5,7,8,9,10,11,12,15,18,19,32,36,38,39,"เดิม","JOB",{"LSV":53,"TCV":68,"THKJV":83,"WEB":98},{"1":54,"2":55,"3":56,"4":57,"5":58,"6":59,"7":60,"8":61,"9":62,"10":63,"11":64,"12":65,"13":66,"14":67},"And Job answers and says:","“How you have helped the powerless, || Saved an arm not strong!","How you have given counsel to the unwise, || And made known wise plans in abundance.","With whom have you declared words? And whose breath came forth from you?","The Rephaim are formed, || Also their inhabitants beneath the waters.","Sheol [is] naked before Him, || And there is no covering to destruction.","Stretching out the north over desolation, || Hanging the earth on nothing,","Binding up the waters in His thick clouds, || And the cloud is not burst under them.","Taking hold of the face of the throne, || Spreading His cloud over it.","He has placed a limit on the waters, || To the boundary of light with darkness.","Pillars of the heavens tremble, || And they wonder because of His rebuke.","By His power He has quieted the sea, || And by His understanding struck the proud.","He beautified the heavens by His Spirit, || His hand has formed the fleeing serpent.","Behold, these [are] the borders of His way, and how little a matter is heard of Him, and who understands the thunder of His might?”",{"1":69,"2":70,"3":71,"4":72,"5":73,"6":74,"7":75,"8":76,"9":77,"10":78,"11":79,"12":80,"13":81,"14":82},"โยบ​จึง​โต้ตอบ​ว่า","“เจ้า​ช่วย​คน​หมด​แรง​ได้​มาก​เสียจริง!\n  ช่วย​พยุง​แขน​ที่​อ่อนล้า​ได้​เยี่ยม​จริง​นะ!","คำ​แนะนำ​ที่​เจ้า​ให้​กับ​คน​ที่​ไร้​ปัญญา​นั้น​ช่าง​ยอดเยี่ยม!\n  เจ้า​ได้​แสดง​ความ​เข้าใจ​ที่​ลึกซึ้ง​เสีย​นี่​กระไร!","ใคร​หนอ​ช่วย​เจ้า​พูด​อย่าง​นี้​ได้\n  วิญญาณ​ของ​ใคร​พูด​ออก​มา​จาก​ปาก​ของ​เจ้า","คน​ตาย​อยู่​ใน​ความ​ทุกข์​ทรมาน\n  ทั้ง​คน​ที่​อยู่​ใต้​น้ำ​และ​ทุก​ชีวิต​ใน​นั้น","แดน​คน​ตาย​เปลือย​เปล่า​ต่อหน้า​พระเจ้า\n  แดน​พินาศ​ไม่​มี​อะไร​ปกปิด","พระเจ้า​คลี่​ท้องฟ้า​ทาง​ทิศ​เหนือ​บน​ความ​ว่าง​เปล่า\n  และ​แขวน​โลก​ไว้​เหนือ​ที่​เวิ้งว้าง","พระองค์​ห่อ​หุ้ม​น้ำ​ไว้​ใน​เมฆ​ของ​พระองค์\n  และ​เมฆ​ก็​ไม่​ได้​แตก​กระจาย​เพราะ​น้ำหนัก​ของ​มัน","พระองค์​คลี่​เมฆ\n  บดบัง​จันทร์​เพ็ญ","พระองค์​กำหนด​เส้น​ขอบฟ้า​ที่​ทะเล\n  เป็น​พรมแดน​ระหว่าง​ความ​สว่าง​กับ​ความ​มืด","เสา​ของ​ฟ้าสวรรค์​สั่น​สะเทือน\n  เมื่อ​พระองค์​กำราบ","ด้วย​ฤทธิ์เดช​ของ​พระองค์ ทะเล​ก็​สงบ​ราบคาบ\n  ด้วย​ปัญญา พระองค์​ฟัน​ราหับ​ออก​เป็น​ชิ้น​ๆ","ด้วย​ลมหายใจ ท้องฟ้า​ก็​สว่าง​สดใส\n  มือ​ของ​พระองค์​แทง​พญา​งู​ที่​กำลัง​เลื้อย​ไป","เหล่า​นี้​เป็น​เพียง​เล็ก​น้อย​ที่​พระองค์​ทำ\n  เป็น​แค่​เสียง​กระซิบ​แผ่ว​ๆ ที่​เรา​ได้ยิน​เกี่ยวกับ​พระองค์!\n  แล้ว​ใคร​จะ​เข้าใจ​ฤทธิ์เดช​เหมือน​ฟ้าร้อง​ของ​พระองค์​ได้”",{"1":84,"2":85,"3":86,"4":87,"5":88,"6":89,"7":90,"8":91,"9":92,"10":93,"11":94,"12":95,"13":96,"14":97},"​แล​้วโยบตอบว่า","“ท่านได้ช่วยผู้​ไม่มี​กำลังมากจริงหนอ ท่านได้ช่วยแขนที่​ไม่มี​แรงแล้วหนอ","ท่านให้คำปรึกษาแก่​คนที​่​ไม่มีสติ​​ปัญญา​ และได้​ให้ความรู้​มากที่​สัมฤทธิ์ผล​\n​จร​ิงหนอ","ท่านเปล่งวาจาออกมาแก่ใครเล่า และวิญญาณของใครได้ออกมาจากท่าน","ชาวแดนคนตายเบื้องล่างสะทกสะท้านใต้น้ำและชาวเมืองนั้น","นรกเปลือยอยู่ต่อพระพักตร์​พระเจ้า​ และแดนพินาศไม่​มี​​ผ้าห่ม​","​พระองค์​ทรงคลี่ทางเหนือออกคลุ​มท​ี่​เวิ้งว้าง​ และแขวนโลกไว้เหนือที่​ว่างเปล่า​","​พระองค์​ทรงมัดน้ำไว้ในเมฆทึบของพระองค์ และเมฆนั้​นก​็​ไม่​ขาดวิ่นไป","​พระองค์​ทรงคลุมหน้าของพระที่​นั่ง​ และคลี่เมฆของพระองค์ออกคลุมมันไว้","​พระองค์​ทรงขีดปริมณฑลไว้บนพื้นน้ำ ​ณ​ เขตระหว่างความสว่างและความมืด","เสาฟ้าก็หวั่นไหวและประหลาดใจเมื่อพระองค์ทรงขนาบ","​พระองค์​ทรงปราบทะเลให้สงบด้วยอานุภาพของพระองค์ ​พระองค์​ทรงตีคนจองหองด้วยความเข้าพระทัยของพระองค์","​พระองค์​ทรงตกแต่งฟ้าสวรรค์ด้วยพระวิญญาณของพระองค์ พระหัตถ์ของพระองค์ทรงสร้างพญานาคที่​ขด​","​ดู​​เถิด​ ​เหล่านี้​เป็นเพียงพระราชกิจผิวเผินของพระองค์ เราได้ยินถึงพระองค์​ก็​เป็นเพียงเสียงกระซิบ\nใครจะเข้าใจถึงฤทธิ์กัมปนาทอันเกรียงไกรของพระองค์​ได้​”",{"1":99,"2":100,"3":101,"4":102,"5":103,"6":104,"7":105,"8":106,"9":107,"10":108,"11":109,"12":110,"13":111,"14":112},"Then Job answered,","“How have you helped him who is without power!\n\nHow have you saved the arm that has no strength!","How have you counseled him who has no wisdom,\n\nand plentifully declared sound knowledge!","To whom have you uttered words?\n\nWhose spirit came out of you?","“The departed spirits tremble,\n\nthose beneath the waters and all that live in them.","Sheol is naked before God,\n\nand Abaddon has no covering.","He stretches out the north over empty space,\n\nand hangs the earth on nothing.","He binds up the waters in his thick clouds,\n\nand the cloud is not burst under them.","He encloses the face of his throne,\n\nand spreads his cloud on it.","He has described a boundary on the surface of the waters,\n\nand to the confines of light and darkness.","The pillars of heaven tremble\n\nand are astonished at his rebuke.","He stirs up the sea with his power,\n\nand by his understanding he strikes through Rahab.","By his Spirit the heavens are garnished.\n\nHis hand has pierced the swift serpent.","Behold, these are but the outskirts of his ways.\n\nHow small a whisper do we hear of him!\n\nBut the thunder of his power who can understand?”",[114,115,116,117],"TCV","THKJV","WEB","LSV",{"LSV":119,"TCV":120,"THKJV":121,"WEB":122},"Literal Standard Version","Thai Common Version 2025","Thai KJV 2003","World English Bible",{"จำนวนบท":124,"จำนวนเล่ม":125,"เล่ม":126},1190,66,[127,143,149,155,164,171,177,182,187,193,198,204,209,215,220,226,232,237,240,328,333,338,343,348,353,358,363,368,373,378,383,388,393,398