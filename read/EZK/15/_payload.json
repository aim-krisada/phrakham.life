[{"data":1,"prerenderedAt":540},["ShallowReactive",2],{"บท:EZK\u002F15":3,"บัญชีเล่ม":107},{"เล่ม":4,"บท":26,"ชั้น":60,"ลำดับชั้น":97,"แหล่งของชั้น":102},{"ข้อสุดท้าย":5,"ชื่อไทย":31,"บท":32,"บทที่มี":33,"พันธสัญญา":58,"รหัส":59},[6,7,8,9,9,10,8,11,12,13,14,6,15,15,16,17,18,19,10,20,19,21,20,8,9,22,23,24,22,24,11,19,25,21,26,27,6,15,28,20,24,29,8,21,14,18,15,30],28,10,27,17,14,18,11,22,25,23,8,63,24,32,49,31,21,36,26,33,15,38,29,20,35,"เอเสเคียล",48,[34,35,36,37,38,39,40,16,41,7,12,42,43,10,26,44,9,11,45,29,22,13,15,18,14,24,8,6,28,46,21,19,25,47,30,23,48,27,49,50,51,52,53,54,55,56,57,32],1,2,3,4,5,6,7,9,12,13,16,19,30,34,37,39,40,41,42,43,44,45,46,47,"เดิม","EZK",{"LSV":61,"TCV":70,"THKJV":79,"WEB":88},{"1":62,"2":63,"3":64,"4":65,"5":66,"6":67,"7":68,"8":69},"And there is a word of YHWH to me, saying,","“Son of man, || What is the vine-tree more than any tree? The vine-branch that has been, || Among trees of the forest?","Is wood taken from it to use for work? Do they take a pin of it to hang any vessel on it?","Behold, it has been given to the fire for fuel, || The fire has eaten its two ends, || And its midst has been scorched! Is it profitable for work?","Behold, in its being perfect it is not used for work, || How much less when fire has eaten of it, || And it is scorched, || Has it been used yet for work?”","Therefore, thus said Lord YHWH: “As the vine-tree among trees of the forest, || That I have given to the fire for fuel, || So I have given the inhabitants of Jerusalem.","And I have set My face against them, || They have gone forth from the fire, || And the fire consumes them, || And you have known that I [am] YHWH, || In My setting My face against them.","And I have made the land a desolation, || Because they have committed a trespass,” || A declaration of Lord YHWH!",{"1":71,"2":72,"3":73,"4":74,"5":75,"6":76,"7":77,"8":78},"ถ้อยคำ​ของ​พระยาห์เวห์​มา​ถึง​ข้าพเจ้า​ว่า","“บุตร​มนุษย์​เอ๋ย ไม้​องุ่น​มี​อะไร​ต่าง​ไป​จาก​กิ่ง​ต้นไม้​ใน​ป่า​หรือ","ไม้​องุ่น​จะ​นำ​มา​ใช้​ประโยชน์​อะไร​ได้​เล่า เอา​มา​ทำ​ที่​แขวน​สิ่งใด​ได้​หรือ","และ​เมื่อ​โยน​ลง​ไป​ใน​ไฟ​เป็น​เชื้อ​เพลิง ไฟ​เผา​ปลาย​ทั้ง​สอง​ข้าง และ​ตรง​กลาง​ลุกไหม้​แล้ว มัน​จะ​ใช้​ประโยชน์​อะไร​ได้","ตอน​ที่​มัน​ยัง​ดี​อยู่​ก็​ทำ​ประโยชน์​อะไร​ไม่​ได้ เมื่อ​ถูก​ไฟ​เผา​ก็​ยิ่ง​ไม่​มี​ประโยชน์","ฉะนั้น พระยาห์เวห์​องค์เจ้าชีวิต​พูด​ดังนี้​ว่า เรา​โยน​ไม้​องุ่น​ท่ามกลาง​ไม้​ต่าง​ๆ ใน​ป่า​เป็น​เชื้อ​ไฟ​ฉันใด เรา​ก็​จะ​ทำ​กับ​ผู้​คน​ที่​อาศัย​อยู่​ใน​เยรูซาเล็ม​ฉันนั้น","เรา​จะ​ตั้ง​ตน​เป็น​ศัตรู​กับ​พวก​เขา แม้​เขา​จะ​หนี​ออก​มา​จาก​ไฟ แต่​ไฟ​ก็​ยัง​จะ​เผาผลาญ​เขา และ​เมื่อ​เรา​ตั้ง​ตน​เป็น​ศัตรู​กับ​พวก​เขา เจ้า​จะ​รู้​ว่า​เรา​คือ​พระยาห์เวห์","เรา​จะ​ทำ​ให้​ดินแดน​นั้น​ถูก​ทิ้ง​ร้าง เพราะ​พวก​เขา​ไม่​ซื่อสัตย์ พระยาห์เวห์​องค์เจ้าชีวิต​ประกาศ​ดังนั้น”",{"1":80,"2":81,"3":82,"4":83,"5":84,"6":85,"7":86,"8":87},"พระวจนะของพระเยโฮวาห์มาถึงข้าพเจ้าว่า","“​บุ​ตรแห่งมนุษย์​เอ๋ย​ ต้นเถาองุ่​นว​ิเศษกว่าต้นไม้​อื่น​ และวิเศษกว่าไม้กิ่งหนึ่งซึ่งอยู่ท่ามกลางต้นไม้ในป่าหรือ","เขาเอาไม้ต้นเถาองุ่นไปทำอะไรบ้างหรือ คนเอาไปทำขอสำหรับแขวนภาชนะอันใดหรือ","​ดู​​เถิด​ เขาใช้เป็นฟืนใส่​ไฟ​ เมื่อไฟไหม้ปลายทั้งสองแล้ว กลางก็เป็นถ่าน\nจะใช้​ประโยชน์​อะไรได้​หรือ​","​ดู​​เถิด​ เมื่​อม​ันยั​งด​ี​อยู่​​ก็​​มิได้​​ใช้ประโยชน์​​อะไร​ เมื่อถูกไฟไหม้เป็นถ่านแล้วยิ่​งม​ี​ประโยชน์​​น้อยลง​\nจะใช้ทำอะไรได้บ้างเล่า","เพราะฉะนั้นองค์พระผู้เป็นเจ้าพระเจ้าจึงตรั​สด​ังนี้​ว่า​ ต้นเถาองุ่นซึ่งอยู่ท่ามกลางต้นไม้ในป่า\nเราทิ้งให้มันเป็นฟืนใส่ไฟเสียฉันใด เราจะทิ้งชาวเยรูซาเล็มฉันนั้น","เราจะมุ่งหน้าของเราต่อสู้​เขา​ ​แม้ว​่าเขาจะหนีออกจากไฟอันหนึ่ง ไฟอี​กอ​ันหนึ่​งก​็ยังจะเผาผลาญเขา\nและเมื่อเรามุ่งหน้าของเราต่อสู้​เขา​ ​เจ้​าจะทราบว่า เราคือพระเยโฮวาห์","​องค์​พระผู้เป็นเจ้าพระเจ้าตรั​สว​่า เราจะกระทำให้​แผ่​นดินนั้นรกร้างไป\nเพราะเขาได้​ประพฤติ​​ละเมิด​”",{"1":89,"2":90,"3":91,"4":92,"5":93,"6":94,"7":95,"8":96},"Yahweh’s word came to me, saying,","“Son of man, what is the vine tree more than any tree, the vine branch which is among the trees of the forest?","Will wood be taken of it to make anything? Will men take a pin of it to hang any vessel on it?","Behold, it is cast into the fire for fuel; the fire has devoured both its ends, and the middle of it is burned. Is it profitable for any work?","Behold, when it was whole, it was suitable for no work. How much less, when the fire has devoured it, and it has been burned, will it yet be suitable for any work?”","Therefore the Lord Yahweh says: “As the vine wood among the trees of the forest, which I have given to the fire for fuel, so I will give the inhabitants of Jerusalem.","I will set my face against them. They will go out from the fire, but the fire will still devour them. Then you will know that I am Yahweh, when I set my face against them.","I will make the land desolate, because they have acted unfaithfully,” says the Lord Yahweh.",[98,99,100,101],"TCV","THKJV","WEB","LSV",{"LSV":103,"TCV":104,"THKJV":105,"WEB":106},"Literal Standard Version","Thai Common Version 2025","Thai KJV 2003","World English Bible",{"จำนวนบท":108,"จำนวนเล่ม":109,"เล่ม":110},1190,66,[111,120,126,132,141,148,153,158,163,169,174,180,185,191,196,202,208,213,218,306,311,316,321,326,331,336,339,344,349,354,359,364,369,374,379,384,389,394,399,404,410,415,420,425,430,435,440,445,450,455,460,465,470,475,480,485,490,495,500,505,510,515,520,525,530,535],{"ข้อสุดท้าย":112,"ชื่อไทย":116,"บท":117,"บทที่มี":118,"พันธสัญญา":58,"รหัส":119},[21,14,18,24,19,13,18,13,28,19,19,29,11,18,22,44,8,25,27,11,47,18,29,113,47,30,56,13,30,53,114,19,29,21,28,53,23,46,15,15,115,27,47,47,6,47,21,13,25,24],67,55,57,"ปฐมกาล",50,[34,35,36,37,38,39,40,16,41,7,12,42,43,10,26,44,9,11,45,29,22,13,15,18,14,24,8,6,28,46,21,19,25,47,30,23,48,27,49,50,51,52,53,54,55,56,57,32,20,117],"GEN",{"ข้อสุดท้าย":121,"ชื่อไทย":123,"บท":50,"บทที่มี":124,"พันธสัญญา":58,"รหัส":125},[13,14,13,21,15,46,14,19,30,28,7,122,13,21,8,23,44,8,14,24,23,21,25,11,50,48,22,53,56,27,11,30,15,30,30,27,28,21,53,27],51,"อพยพ",[34,35,36,37,38,39,40,16,41,7,12,42,43,10,26,44,9,11,45,29,22,13,15,18,14,24,8,6,28,46,21